{
    "installCommand":  "pnpm install --no-frozen-lockfile",
    "redirects":  [
                      {
                          "source":  "/",
                          "destination":  "https://loja.landiturbina.com.br",
                          "permanent":  true
                      }
                  ],
    "rewrites":  [
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ]
}
