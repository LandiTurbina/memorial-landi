rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leads2/{leadId} {
      allow read, update, delete: if false;
      allow create: if isValidLead();
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidLead() {
      return request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'rawPhone',
          'ddd',
          'number',
          'page',
          'href',
          'referrer',
          'userAgent',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\([0-9]{2}\\) [0-9]{5}-[0-9]{4}$')
        && request.resource.data.rawPhone is string
        && request.resource.data.rawPhone.matches('^[0-9]{11}$')
        && request.resource.data.ddd is string
        && request.resource.data.ddd.matches('^[0-9]{2}$')
        && request.resource.data.number is string
        && request.resource.data.number.matches('^[0-9]{9}$')
        && request.resource.data.page == '/novociclo'
        && request.resource.data.href is string
        && request.resource.data.href.size() <= 200
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 300
        && (request.resource.data.referrer == null || request.resource.data.referrer is string)
        && request.resource.data.createdAt == request.time;
    }
  }
}
